<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationIcon>../../assets/GHNotif.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../GHNotif.Core/GHNotif.Core.csproj" />
    <Content Include="../../assets/GHNotif.ico" Link="GHNotif.ico" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="../../assets/GHNotif.png" Link="GHNotif.png" />
  </ItemGroup>
</Project>
