<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationIcon>../../assets/GHNotif.ico</ApplicationIcon>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../VERSION').Trim())</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../GHNotif.Core/GHNotif.Core.csproj" />
    <Content Include="../../assets/GHNotif.ico" Link="GHNotif.ico" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Resource Include="../../assets/GHNotif.png" Link="GHNotif.png" />
    <!-- Notification badges shared with macOS; generated by scripts/generate-notification-badges.swift. -->
    <Content Include="../../Sources/GHNotif/Resources/badge-*.png" Link="Badges/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="../../Sources/GHNotif/Resources/Octicons-LICENSE.txt" Link="Badges/Octicons-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>
</Project>
